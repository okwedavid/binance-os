# ---------------------------------------------------------------------------
# RiskLens environment configuration — all values are optional.
# No Binance API key is required for Agent OS.
# ---------------------------------------------------------------------------

# Recommended for production: a stable secret used to sign the httpOnly
# session/state cookies and the one-shot execution authorizations.
# Must be at least 16 characters. If unset, a per-process random key is
# used (safe — it only forces a reconnect after an instance restart).
RL_COOKIE_SECRET=19DKTxs/iZbO9+1C7YEspikTim8J55wWmhlvCai+c6gvpBh9AJn9sSgKkKLC9dIb

# Optional: override the Binance Agent OS MCP endpoint.
# Defaults to the official endpoint: https://agent.binance.com/mcp/agentic
# AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic

# Optional: OAuth scope requested from Binance Agent OS.
# Defaults to "market_data account trade". Do not add "transfer" unless the
# deployment actually needs it.
# AGENT_OS_SCOPE=market_data account trade

# Optional compatibility overrides: a pre-registered OAuth client.
# RiskLens normally uses Binance's Client ID Metadata Document flow
# automatically — the deployment's public HTTPS metadata URL
# (/api/agentos/client-metadata.json) IS the client_id, no registration
# step or API key is required.
# Set these ONLY if Binance provisioned you an explicit client:
# AGENT_OS_CLIENT_ID=
# AGENT_OS_CLIENT_SECRET=
# The secret is resolved from this environment at exchange/refresh time and
# is NEVER stored in cookies or returned to the browser.